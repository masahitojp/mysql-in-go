+
+func TestAMD64WeakGOTCompareImmediateZero(t *testing.T) {
+	for _, valid := range []bool{true, false} {
+		code := []byte{0x48, 0x83, 0x3d, 0, 0, 0, 0, 0}
+		if !valid {
+			code[1] = 0x8b
+		}
+		m := &image{machine: elf.EM_X86_64, sections: []section{{}, {name: ".text", typ: elf.SHT_PROGBITS, flags: elf.SHF_ALLOC | elf.SHF_EXECINSTR, align: 16, size: 8, data: code, relocs: []reloc{{off: 3, sym: 1, typ: elf.R_AARCH64(elf.R_X86_64_GOTPCREL), add: -5}}}}, symbols: []symbol{{}, {name: "optional", info: byte(elf.STB_WEAK) << 4}}}
+		err := (&Plan{Namespace: "cmp_"}).bindAMD64([]*image{m}, nil)
+		if !valid {
+			if err == nil {
+				t.Fatal("invalid instruction accepted")
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		r := m.sections[1].relocs[0]
+		if elf.R_X86_64(r.typ) != elf.R_X86_64_PC32 || r.add != -5 {
+			t.Fatal("comparison must read null cell with trailing-immediate RIP bias")
+		}
+	}
+}
